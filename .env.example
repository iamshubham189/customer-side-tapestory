# ============================================================================
# TAPESTORY CUSTOMER WEBSITE — ENVIRONMENT VARIABLES
# Copy this file to .env.local and supply your credentials.
# Never commit .env.local or expose server-only keys with NEXT_PUBLIC_.
# ============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Razorpay Payment Gateway Configuration (INR)
# Public Key ID is safe for client checkout initialization
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
